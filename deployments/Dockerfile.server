# Stage 1: Build the statically-linked Go binary
FROM golang:1.24-alpine AS builder

WORKDIR /workspace

# Install essential compilation dependencies and tools (CGO required for tree-sitter AST)
RUN apk add --no-cache ca-certificates git tzdata gcc g++ musl-dev

# Leverage Docker layer caching for Go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy the entire source repository
COPY . .

# Compile optimized binary with CGO
ENV CGO_ENABLED=1
RUN go build -ldflags="-s -w" -o /bin/ov-server ./cmd/ov-server

# Stage 2: Hardened Go runtime with Git, C compilers and Pi/Pi-Bolt agent harness
FROM alpine:3.21

# Install runtime tools: go for testing code, git for worktree operations, gcc/musl-dev for CGO, nodejs/npm for Pi agent harness
RUN apk add --no-cache ca-certificates tzdata wget git go musl-dev gcc nodejs npm \
    && npm install -g @earendil-works/pi-coding-agent \
    && ln -sf $(which pi) /usr/local/bin/pb 2>/dev/null || true \
    && addgroup -g 10001 -S nonroot \
    && adduser -u 10001 -S -G nonroot -h /home/nonroot nonroot \
    && mkdir -p /tmp/ov-sandboxes /home/nonroot/.pi /home/nonroot/.agents \
    && chown -R 10001:10001 /tmp/ov-sandboxes /home/nonroot

WORKDIR /home/nonroot

# Copy application binary with nonroot ownership
COPY --from=builder /bin/ov-server /usr/local/bin/ov-server

# Switch to unprivileged UID 10001
USER 10001:10001

# Default API port
EXPOSE 8080

# Health check configuration probing the /healthz endpoint
HEALTHCHECK --interval=5s --timeout=5s --retries=5 --start-period=5s \
  CMD wget -q --spider http://localhost:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/ov-server"]
