# ==============================================================================
# OV-Factory Orchestration Stack Environment Configuration (.env.example)
# ==============================================================================

# --- PostgreSQL & pgvector (The Brain) ---
POSTGRES_USER=ov_user
POSTGRES_PASSWORD=ov_password
POSTGRES_DB=ov_factory
POSTGRES_PORT=5432
DATABASE_URL=postgres://ov_user:ov_password@postgres:5432/ov_factory?sslmode=disable

# --- NATS JetStream Message Bus ---
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://nats:4222

# --- Hatchet Durable Workflow Engine ---
HATCHET_PORT=7077
HATCHET_JWT_SECRET=devjwtsecretdevjwtsecretdevjwtsecret

# --- Svix Outbound Webhooks ---
SVIX_PORT=8071
SVIX_JWT_SECRET=devsvixsecretdevsvixsecret

# --- OV-Server (API, Gateway & Orchestrator) ---
SERVER_PORT=8080

# --- OV-Worker (Execution Daemon & Sandboxes) ---
WORKER_HEALTH_PORT=8081
OV_WORKTREE_DIR=/tmp/ov-sandboxes

# --- OV-Web (Visual DAG & Execution Dashboard) ---
WEB_PORT=3000

# --- Inbound Webhook Connector Secrets (Local Dev Defaults) ---
GITHUB_WEBHOOK_SECRET=dev_github_secret
GITLAB_WEBHOOK_SECRET=dev_gitlab_secret
SENTRY_WEBHOOK_SECRET=dev_sentry_secret

# --- Chat Adapters (Slack & Discord - Optional) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_DEFAULT_CHANNEL=
