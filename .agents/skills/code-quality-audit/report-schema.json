              "type": "string",
              "minLength": 1,
              "visibleContent": true
            }
          },
          "validation_plan": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          }
        },
        "required": [
          "verdict",
          "fingerprint",
          "title",
          "description",
          "quality_class",
          "subsystem",
          "claimed_root_cause",
          "trace",
          "evidence",
          "blockers",
          "validation_plan"
        ],
        "additionalProperties": false
